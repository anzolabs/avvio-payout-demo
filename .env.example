# A SANDBOX key. Create it on the Developer page while the org menu says "Sandbox".
AVVIO_API_KEY=avvio_test_...

# The organization id from the Developer page header. Same id for test and live.
AVVIO_ORG_ID=cmsx...

# One base URL for both environments; the key prefix picks the environment.
AVVIO_BASE_URL=https://api.avvio.xyz/business/api/v1

# The whsec_ secret shown once when you add the webhook endpoint (Developer page,
# Webhooks tab, in the Sandbox org). Leave empty to run without webhooks: the
# backend then learns every outcome by polling, which is slower but complete.
AVVIO_WEBHOOK_SECRET=

# Destination currency for the links. MXN is the sandbox corridor.
DESTINATION_CURRENCY=MXN

PORT=4300
